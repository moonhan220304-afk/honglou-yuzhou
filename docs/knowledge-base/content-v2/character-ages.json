  "controversies": [
    {
      "title": "黛玉第45回「我长了今年十五岁」vs 第25回宝玉十三载系统",
      "detail": "依第25回「青埂峰一别，展眼已过十三载矣」，宝玉13岁、黛玉应约12岁；第45回黛玉却自称十五岁。庚辰夹批「黛玉才十五岁，记清」；周汝昌《红楼纪历》：「按本年宝玉十三岁，凡小于宝玉者不能超过十三岁……此为信笔泛叙」；张俊沈治钧批「此处所报年龄似误，诸本皆然」。",
      "fact_type": "disputed_version"
    },
    {
      "title": "刘姥姥75岁 vs 贾母两年后八十大寿",
      "detail": "第39回刘姥姥自报75岁、贾母说「比我大好几岁」→贾母约70岁；第71回却铺写「贾母八旬之庆」，按叙事时间只过两年，诸本皆然。",
      "fact_type": "disputed_version"
    },
    {
      "title": "第49回「皆不过十五六七岁」把凤姐算入",
      "detail": "庚辰本等第49回：「除李纨年纪最长，他十二个人皆不过十五六七岁」——凤姐已二十六七岁被算入，程高本改为「李纨年纪最长，凤姐次之，余者皆不过十五六七岁」。",
      "fact_type": "disputed_version"
    },
    {
      "title": "黛玉进府年龄的版本异文",
      "detail": "庚辰本体系黛玉六岁进府；己卯本杨藏本黛玉答凤姐「十三岁」。刘上生：明义所见《红楼梦初稿》以十三岁为黛玉叙事起点，曹雪芹合成《石头记》时改小，抄手将初稿年龄移植回来，打乱整个年龄系统。",
      "fact_type": "disputed_version"
    },
    {
      "title": "三套年龄体系说（石问之）",
      "detail": "石问之《林黛玉进贾府年龄问题再探》：书中至少三套年龄体系——①第2回体系（宝玉7-8岁、黛玉6-7岁）②第22-25回体系（宝钗15岁、宝玉13岁）③第4回体系（宝钗13岁、宝玉11岁、黛玉10岁）。他认为黛玉六岁进府「根本无法与第三回的描写和人物形象相匹配」，但无论改用哪套，都无法弥合宝黛初见「童性年龄与少年青春气息二重性」的矛盾。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "第2回「次年」生宝玉 vs 第18回「情状有如母子」",
      "detail": "甲戌己卯庚辰诸本第2回作「不想次年又生一位公子」——元春与宝玉只差一岁；第18回却说元春对宝玉「名分虽系姊弟，其情状有如母子」。冯其庸：冷子兴是胡吹乱说、套近乎的商人，前后两段话说话人不同，不能视为矛盾；程乙本改为「隔了十几年」，胡适认为是「晚出之铁证」。",
      "fact_type": "disputed_version"
    },
    {
      "title": "湘云称黛玉「林姐姐」又称「林妹妹」",
      "detail": "第20回称「林姐姐」、第22回称「林妹妹」。曹金钟《红楼梦人物年龄「矛盾」考论》：后者是湘云借用宝玉口吻脱口而出（宝玉常「林妹妹」不离口），符合其心直口快性格，舒序本改「林妹妹」恐为妄改。第38回贾母对湘云说「别让你宝哥哥林姐姐多吃了」可证黛玉比湘云大。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "凤姐与贾珍「从小儿一处淘气」（第54回）",
      "detail": "凤姐比贾珍小十五岁上下，二人不可能「从小儿一处淘气了这么大」。曹金钟：这是凤姐夸张之语，意在表现「男人万不及一」的爽利大方。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "大丫鬟年龄之谜（人民网刊文）",
      "detail": "按年推算，第3回袭人仅约9岁，与其「每每规谏宝玉，心中着实忧郁」的言行不符；凤姐第6回「不过二十岁上下」，四五年后第49回反而只剩「十五六七岁」。作者似有意识让小者增大、大者减小，统合于「十五六七岁」标准——这是与「两玉」六七八岁青梅竹马设定配套的青春化处理。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "板儿「一进」「二进」不长大（刘上生）",
      "detail": "第6回板儿「才五六岁的孩子」，四五年后「二进」（39-42回）仍怯人贪玩、仍被一巴掌打哭，大姐儿四五年后仍「奶子抱着」、六七岁尚未取名——证明「一进」「二进」实际只隔一年，作者刻意拉长叙时以配合宝玉十三岁线。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "刘上生「大时间观」理论",
      "detail": "曹雪芹明言「何必拘拘于朝代年纪哉」（第一回），「无朝代年纪可考」是其主动的叙时策略：大而言之王朝世代、小而言之人物年龄都刻意模糊，以凸显「事体情理」。人物年龄错迕既是「增删五次」的修改痕迹，也是化消极为积极的「新奇别致」笔墨。",
      "fact_type": "scholarly_viewpoint"
    },
    {
      "title": "周汝昌《红楼纪历》",
      "detail": "周汝昌编《红楼纪历》以贾宝玉年龄为纲：前八十回共约十五年（宝玉降生至18岁），通灵历20年。刘姥姥一进在「红楼八年或九年」（宝玉八九岁），二进在「红楼十三年」（宝玉十三岁）。",
      "fact_type": "scholarly_viewpoint"
    }
